# ---------------------------------------------------------------------------
# Copy this file to .env  (local)  and paste the same keys into
# Vercel -> Project -> Settings -> Environment Variables  (production).
# NEVER commit .env
# ---------------------------------------------------------------------------

# --- Supabase (Dashboard -> Project Settings -> API) ------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# service_role key: server-side ONLY. Bypasses RLS. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Telegram (from @BotFather) ---------------------------------------------
TELEGRAM_BOT_TOKEN=123456:AA...
# Any long random string you invent. Telegram echoes it back on every webhook
# call so we can prove the request really came from Telegram.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- LLM --------------------------------------------------------------------
# openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# gpt-4.1-nano is cheaper (~4x) and fine for English, but it was measurably
# weaker in Arabic: it lost shipment references, garbled dates, and in one test
# invented a destination city (Aswan) that is not a port we serve.
# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Embeddings for RAG. Always OpenAI (Anthropic has no embeddings endpoint).
# Leave OPENAI_API_KEY blank to fall back to Postgres full-text search.
EMBEDDING_MODEL=text-embedding-3-small

# --- App --------------------------------------------------------------------
COMPANY_NAME=MKY Global Forwarding
# Shown in the footer of the booking confirmation PDF.
COMPANY_EMAIL=bookings@mkyglobal.example
COMPANY_PHONE=+20 3 555 0143
BOOKING_FORM_URL=https://example.com/mkc-booking-form
# Protects /api/admin/* . Invent a long random string.
ADMIN_SECRET=change-me-too
# Optional. Your deployed base URL, e.g. https://mkc-global.vercel.app
# Only used by CLI scripts - the server falls back to the request host.
# Do not name it PUBLIC_* on Vercel: that prefix is reserved for browser-exposed
# framework variables and cannot be stored as a secret.
APP_BASE_URL=

# --- Booking notifications ---------------------------------------------------
# Email via Resend (https://resend.com) - free tier, 3,000 emails/month.
# Without a verified domain you can only send FROM onboarding@resend.dev
# and only TO the address you signed up with. Verify a domain to send freely.
RESEND_API_KEY=re_...
MAIL_FROM=MKC Global Logistics <onboarding@resend.dev>
# Who on your team gets every new booking. Comma-separate for several people.
OPS_EMAIL=bookings@yourcompany.com

# Telegram group where staff are pinged with the booking PDF.
# Add the bot to the group, send a message, then run: npm run chatid
STAFF_CHAT_ID=
