{
  "name": "mkc-global-chatbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MKC Global Logistics AI chatbot - Telegram + web, backed by Supabase",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen:data": "node scripts/generate-demo-data.mjs",
    "seed": "node scripts/seed-db.mjs",
    "ingest": "node scripts/ingest.mjs",
    "setup:webhook": "node scripts/set-webhook.mjs",
    "dev": "vercel dev",
    "smoke": "node scripts/smoke-test.mjs",
    "chatid": "node scripts/find-chat-id.mjs",
    "test:pdf": "node scripts/test-notify.mjs",
    "flowtest": "node scripts/flow-test.mjs",
    "artest": "node scripts/arabic-test.mjs",
    "db:push": "supabase db push",
    "db:link": "supabase link --project-ref kverwgcnvnferjewvvyr",
    "edittest": "node scripts/edit-test.mjs",
    "opstest": "node scripts/ops-test.mjs",
    "rotate": "node scripts/rotate-secrets.mjs",
    "pintest": "node scripts/pin-test.mjs",
    "guide": "node scripts/make-guide.mjs",
    "reread": "node scripts/reread-documents.mjs",
    "testdocs": "node scripts/make-test-docs.mjs",
    "test": "node --test tests/flow.test.mjs tests/operations.test.mjs tests/extract.test.mjs",
    "test:watch": "node --test --watch tests/flow.test.mjs tests/operations.test.mjs tests/extract.test.mjs",
    "outbox": "node scripts/drain-outbox.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bidi-js": "^1.0.3",
    "pdfkit": "^0.15.0",
    "pdfjs-dist": "^4.7.76",
    "@napi-rs/canvas": "^0.1.100"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0"
  }
}
